{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loggia",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-01",

  // 다섯 페이지. 워커가 직접 내준다.
  // 자리를 찾은 요청은 파일이 먼저 나가고, 못 찾은 요청만 워커가 받는다.
  // 그래서 /send 는 워커에게 닿고 / 는 index.html 이 나간다.
  "assets": {
    "directory": "./public"
  },

  // 해치운 할 일 기록. 기기끼리 같은 줄을 보게 한다.
  // 이름공간 loggia-ledger 하나에 board 라는 칸 하나뿐이다.
  "kv_namespaces": [
    { "binding": "LEDGER", "id": "19adfab3939447df80d35084d96d1656" }
  ],

  // 클라우드플레어 이메일 서비스. 아침 메일을 부치는 곳
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],

  // 크론은 UTC 로 돈다. 서울은 서머타임이 없으므로 늘 아홉 시간 앞선다.
  //   0 22 * * *     22:00 UTC = 이튿날 07:00 서울. 아침 메일
  //   */10 * * * *   10분마다. 사이트에서 체크하거나 추가한 것을 데이터에 반영한다.
  //                  반영할 게 없으면 아무것도 하지 않고, 시크릿이 없으면 그냥 건너뛴다.
  "triggers": {
    "crons": ["0 22 * * *", "*/10 * * * *"]
  },

  "vars": {
    // 편지가 읽는 꾸러미는 깃허브에서 받는다.
    // 워커의 제 살림에서 읽지 않는 이유는, 배포가 어긋나도 편지가 최신을
    // 읽게 하기 위해서다. 판과 편지는 서로 기대지 않는 편이 낫다.
    "DIGEST_URL": "https://raw.githubusercontent.com/eeruwang/loggia/main/digest.enc",

    // 공고 루틴이 저장소에 써 두는 자리. 워커가 열 분마다 훑어 판으로 옮긴다.
    // 예약 작업에는 바깥으로 글을 보낼 손이 없으므로 저장소를 사이에 둔다.
    "JOBS_URL": "https://raw.githubusercontent.com/eeruwang/loggia/main/jobs/latest.json",
    "MAIL_TO": "moon@ilsunmoon.com",
    "MAIL_FROM": "info@loggia.moonilsun.com"
  },

  "observability": {
    "enabled": true
  }
}
